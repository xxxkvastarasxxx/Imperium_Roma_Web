# =============================================================================
# SECURITY NOTICE: Do NOT put secrets in this file if it's tracked by Git!
# Set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID via:
#   1. Hosting control panel environment variables, OR
#   2. config/telegram.php file (must be gitignored)
# =============================================================================

# PHP security hardening for upload handling
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 12M
  php_value max_file_uploads 5
</IfModule>

# Protect config directory from web access
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^config/ - [F,L]
</IfModule>

# Block direct access to sensitive files
<FilesMatch "(^\.htaccess|\.php\.bak|telegram\.php)$">
  Require all denied
</FilesMatch>
