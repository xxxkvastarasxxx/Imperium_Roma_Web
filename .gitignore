# =============================================================================
# Git Ignore - Imperium Roma Web
# =============================================================================

# Secrets and sensitive configuration
config/telegram.php
config/newsletter.php
config/*.pem
*.env
.env*

# Keep example/template files
!config/telegram.example.php
!*.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.cache

# PHP
vendor/
composer.lock

# Node
node_modules/

# Build output (generated by `npm run build`; deployed via CI, never committed)
dist/

# Test/placeholder files
**/fake*.jpg
**/fake*.png
**/test*.jpg
**/test*.png

# IndexNow submission state (per-page content hashes; persisted via CI cache)
.indexnow-state.json
